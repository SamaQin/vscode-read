{
  "name": "vscode-read",
  "displayName": "VSCode Read",
  "description": "在编辑器视窗中阅读小说，支持章节跳转和持久化进度。",
  "version": "0.1.7",
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "novel-reader.open", "title": "小说阅读: 打开/导入小说" },
      { "command": "novel-reader.next", "title": "小说阅读: 下一段" },
      { "command": "novel-reader.prev", "title": "小说阅读: 上一段" },
      { "command": "novel-reader.nextChapter", "title": "小说阅读: 下一章" },
      { "command": "novel-reader.prevChapter", "title": "小说阅读: 上一章" },
      { "command": "novel-reader.toggleHide", "title": "小说阅读: 隐藏/显示" },
      { "command": "novel-reader.close", "title": "小说阅读: 关闭显示" },
      { "command": "novel-reader.jumpTo", "title": "小说阅读: 快速跳转" },
      { "command": "novel-reader.statusMenu", "title": "小说阅读: 打开阅读菜单" }
    ],
    "keybindings": [
      { "command": "novel-reader.next", "key": "alt+q" },
      { "command": "novel-reader.prev", "key": "alt+shift+w" },
      { "command": "novel-reader.nextChapter", "key": "alt+shift+z" },
      { "command": "novel-reader.prevChapter", "key": "alt+shift+x" },
      { "command": "novel-reader.toggleHide", "key": "ctrl+alt+q" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "novelReader", "title": "小说阅读", "icon": "media/book.svg" }
      ]
    },
    "views": {
      "novelReader": [
        { "id": "novelReader.sidebar", "name": "阅读控制", "type": "webview" }
      ]
    },
    "configuration": {
      "title": "VSCode Read",
      "properties": {
        "novelReader.content": { "type": "array", "items": { "type": "string" }, "default": [], "description": "小说段落。" },
        "novelReader.currentIndex": { "type": "number", "default": 0, "minimum": 0 },
        "novelReader.chapterIndex": { "type": "number", "default": 0, "minimum": 0 },
        "novelReader.chapters": { "type": "array", "default": [], "items": { "type": "object" } },
        "novelReader.enabled": { "type": "boolean", "default": false },
        "novelReader.hidden": { "type": "boolean", "default": false },
        "novelReader.bookName": { "type": "string", "default": "未命名小说" },
        "novelReader.lastOpened": { "type": "string", "default": "" },
        "novelReader.history": { "type": "array", "default": [], "items": { "type": "object" } },
        "novelReader.loopAtEnd": { "type": "boolean", "default": true, "description": "翻页到末尾后是否循环到开头。" },
        "novelReader.textOpacity": { "type": "number", "default": 1, "minimum": 0.1, "maximum": 1, "description": "小说文字透明度。" },
        "novelReader.textColor": { "type": "string", "default": "", "description": "小说文字颜色，留空时跟随编辑器。" }
      }
    }
  },
  "scripts": { "compile": "tsc -p ./", "watch": "tsc -watch -p ./", "package": "npm run compile && vsce package" },
  "devDependencies": { "@types/node": "^20.0.0", "@types/vscode": "^1.85.0", "typescript": "^5.3.0", "@vscode/vsce": "^2.24.0" },
  "dependencies": { "jszip": "^3.10.1" }
}
